DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# live calls real services; demo is visibly labelled and never calls a generation provider.
STUDIO_MODE=live
# Local application data, assets and LangGraph checkpoints. Excluded from git.
STUDIO_DATA_DIR=.data
# Use the endpoint and API key belonging to the SAME account region/workspace.
# Beijing example: https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
DASHSCOPE_IMAGE_ENDPOINT=
DASHSCOPE_API_KEY=
DASHSCOPE_IMAGE_MODEL=qwen-image-3.0
# Beijing example: https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/video-generation/video-synthesis
DASHSCOPE_VIDEO_ENDPOINT=
WAN_MODEL=wan3.0-video
# Optional, defaults to the video endpoint origin plus /api/v1/tasks
DASHSCOPE_TASK_ENDPOINT=
